# ─────────────────────────────────────────────────────────────
# Amosix environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Only variables prefixed with VITE_ are exposed to the browser bundle,
# so never put a secret/service key here — those belong on a server.
# ─────────────────────────────────────────────────────────────

# Which auth backend to use: "mock" (default, no account needed) or "supabase".
VITE_AUTH_PROVIDER=mock

# Required only when VITE_AUTH_PROVIDER=supabase.
# The anon (public) key is safe for the browser. Do NOT use the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
