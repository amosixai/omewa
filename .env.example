# ─────────────────────────────────────────────────────────────
# Amosix environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Only variables prefixed with VITE_ are exposed to the browser bundle,
# so never put a secret/service key here — those belong on a server.
# ─────────────────────────────────────────────────────────────

# Backends: "mock" (default, no account needed) or "supabase".
# Auth and social data are switched independently.
VITE_AUTH_PROVIDER=mock
VITE_SOCIAL_PROVIDER=mock

# Required only when a provider above is set to "supabase".
# Apply supabase/schema.sql to your project first.
# The anon (public) key is safe for the browser. Do NOT use the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
